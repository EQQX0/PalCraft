-            elseif #rows < MAXN then
-                local ok, row = pcall(describe, a, pawnAddr, env.feet, r2)
-                if ok and row then rows[#rows + 1] = row end
-            end
+        lookIn = lookIn - 1
+        if lookIn <= 0 then
+            lookIn = P.tune.entity_far_tables
+            look_over(pawnAddr, env.feet, r2)
+        end
+        for addr, a in pairs(near) do
+            if #rows >= MAXN then break end
+            local ok, row = pcall(describe, a, addr, pawnAddr, env.feet, r2)
+            if ok and row then rows[#rows + 1] = row end
         end
+    else
+        lookIn = 0
     end
