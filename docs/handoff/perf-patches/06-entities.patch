+-- Most of Palworld's characters are out of reach, and finding that out is a call into Unreal each. All of them
+-- are looked over every entity_far_tables tables; in between only those found within reach then are asked, so
+-- a Pal that walks into reach shows up that much later, at the far edge.
+local function look_over(pawnAddr, feet, r2)
+    near = {}
+    for addr, a in pairs(known) do
+        if not a:IsValid() then
+            known[addr] = nil
+        elseif addr ~= pawnAddr then
+            local ok, l = pcall(a.K2_GetActorLocation, a)
+            if ok then
+                local x, y, z = U.to_host(l.X, l.Y, l.Z)
+                local dx, dy, dz = x - feet[1], y - feet[2], z - feet[3]
+                if dx * dx + dy * dy + dz * dz <= r2 then near[addr] = a end
+            end
+        end
+    end
 end
